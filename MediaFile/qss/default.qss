#MainWindow {
    background-color: #000000;
}
#MainWindowFuncButtonWidget {
    background-color: #ffffff;
}

#FuncButton {
    /* 核心：浅白色内部填充 */
    background-color: #f5f7fa;  /* 柔和的浅白色，适配蓝色边框更协调 */
    /* 核心：蓝色边框（宽度+样式+颜色） */
    border: 2px solid #2196F3;  /* 2px 实线边框，经典蓝色（可自行调整色值） */
    border-radius: 8px;         /* 圆角（可选，让按钮更美观） */

    /* 字体相关（保留你原有配置，替换为自定义字体） */
    font-family: "CC Round Black";
    font-size: 16px;
    letter-spacing: 0.06em;
    font-weight: 500;
    color: #333333;             /* 文字颜色（深灰，对比浅白色背景更清晰） */

    /* 清除原生样式干扰 */
    outline: none;              /* 去掉点击后的默认外边框 */
}

#FuncButton:hover {
    background-color: rgba(66, 133, 244, 100);
}
#FuncButton:pressed {
    background-color: #e0e7ff;
    border-color: #0D47A1;
}